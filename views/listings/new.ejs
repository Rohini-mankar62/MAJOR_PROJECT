<% layout("/layout/boilerplate") -%>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-2">
                <br>
                <br>
                <h3>Create a new Listing</h3>
                <form method="POST" action="/listings" novalidate class="needs-validation"
                    enctype="multipart/form-data">

                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title" name="listing[title]" placeholder="Add a catchy title"
                            class="form-control" required>
                        <div class="valid-feedback">
                            Title looks good!
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" name="listing[description]" placeholder="Enter description"
                            class="form-control" required></textarea>
                        <div class="invalid-feedback">
                            Please enter a short description
                        </div>
                    </div>

                    <!-- Image -->
                    <!-- <div class="mb-3">
                    <label for="image" class="form-label">Image Link</label>
                    <input id="image" name="listing[image][url]" placeholder="Enter image URL/LINK" type="text" class="form-control">
                </div> -->

                    <form action="/listings" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="image" class="form-label">Upload Listing Image</label>
                            <input id="image" name="listing[image]" type="file" class="form-control">
                        </div>

                        <!-- Price & Location -->
                        <div class="row">
                            <div class="mb-3 col-md-4">
                                <label for="price" class="form-label">Price</label>
                                <input id="price" type="number" name="listing[price]" placeholder="1200"
                                    class="form-control" required>
                                <div class="invalid-feedback">
                                    Price should be valid
                                </div>
                            </div>

                            <div class="mb-3 col-md-8">
                                <label for="location" class="form-label">Location</label>
                                <input id="location" name="listing[location]" placeholder="Jaipur, Rajasthan"
                                    type="text" class="form-control" required>
                                <div class="invalid-feedback">
                                    Location should be valid
                                </div>
                            </div>
                        </div>

                        <!-- Country -->
                        <div class="mb-3">
                            <label for="country" class="form-label">Country</label>
                            <input id="country" name="listing[country]" placeholder="India" type="text"
                                class="form-control" required>
                            <div class="invalid-feedback">
                                Country name should be valid
                            </div>
                        </div>

                        <br>
                        <br>

                        <button class="btn btn-dark add-btn mt-3" type="submit">Add</button>

                    </form>
            </div>
        </div>
    </body>