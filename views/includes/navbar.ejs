<style>
.search-bar {
    width: 700px;
    height: 66px;
    background-color: white;
    border: 1px solid #ddd;
    border-radius: 40px;
    display: flex;
    align-items: center;
    padding: 5px 7px 5px 25px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    margin: 0 auto;
}
.search-section {
    height: 42px;
    display: flex;
    align-items: center;
    padding: 0 25px;
    border-right: 1px solid #ddd;
}
.where-section {
    width: 250px;
    padding-left: 5px;
}
.when-section {
    width: 200px;
}
.who-section {
    width: 170px;
    border-right: none;
}
.search-option {
    border: none;
    background: transparent;
    padding: 0;
    text-align: left;
    width: 100%;
    cursor: pointer;
}
.search-option:hover {
    background-color: transparent;
}
.search-option::after {
    display: none !important;
}
.search-option strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #222;
    margin-bottom: 3px;
}
.search-option span {
    display: block;
    font-size: 14px;
    color: #777;
    white-space: nowrap;
}
.search-circle {
    width: 48px;
    height: 48px;
    min-width: 48px;
    border: none;
    border-radius: 50%;
    background-color: #fe424d;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    cursor: pointer;
    margin-left: auto;
}
.search-circle:hover {
    background-color: #e8313d;
    color: white;
}
.destination-dropdown {
    width: 390px;
    border: none;
    border-radius: 20px;
    padding: 18px 10px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.18);
    margin-top: 12px !important;
}
.suggested-title {
    font-size: 13px;
    color: #555;
    padding: 5px 15px 10px;
    margin: 0;
}
.destination-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 9px 10px;
    border-radius: 12px;
    cursor: pointer;
}
.destination-item:hover {
    background-color: #f7f7f7;
}
.destination-icon {
    width: 55px;
    height: 55px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
}
.nearby {
    background-color: #edf5fc;
    color: #5596d5;
}
.goa {
    background-color: #faf5ed;
    color: #c59a5a;
}
.lonavala {
    background-color: #fff0f3;
    color: #ff5a73;
}
.pune {
    background-color: #f1f1f1;
    color: #999;
}
.south-goa {
    background-color: #eef7f0;
    color: #229044;
}
.mumbai {
    background-color: #eef7f0;
    color: #229044;
}
.nagpur {
    background-color: #edf5fc;
    color: green;
}
.destination-text strong {
    display: block;
    font-size: 14px;
    color: #333;
}
.destination-text small {
    display: block;
    font-size: 13px;
    color: #777;
    margin-top: 3px;
}
.navbar {
    min-height: 80px;
}
.mobile-menu {
    display: none;
}
.guest-dropdown {
    width: 400px;
    background-color: white;
    border: none;
    border-radius: 20px;
    padding: 15px 25px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.18);
    margin-top: 12px !important;
    position: relative;
}
.guest-close {
    position: absolute;
    top: 15px;
    right: 18px;
    border: none;
    background: transparent;
    font-size: 22px;
    color: #333;
    cursor: pointer;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.guest-close:hover {
    background-color: #f5f5f5;
}
.guest-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-bottom: 1px solid #eee;
}
.guest-row.last-row {
    border-bottom: none;
}
.guest-info strong {
    display: block;
    font-size: 16px;
    font-weight: 500;
    color: #222;
    margin-bottom: 3px;
}
.guest-info small {
    display: block;
    font-size: 14px;
    color: #777;
}
.service-animal {
    text-decoration: underline;
    font-weight: 500;
}
.guest-counter {
    display: flex;
    align-items: center;
    gap: 15px;
}
.guest-counter span {
    width: 20px;
    text-align: center;
    font-size: 15px;
    color: #333;
}
.counter-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background-color: #f3f3f3;
    color: #333;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.2s;
}
.counter-btn:hover {
    background-color: #e8e8e8;
}
.counter-btn:active {
    transform: scale(0.95);
}
@media (max-width:1200px) {
    .search-bar {
        width: 600px;
    }
    .where-section {
        width: 210px;
    }
    .when-section {
