        max-width: 90vw;
    }
    .guest-dropdown {
        width: 330px;
        max-width: 90vw;
        padding: 15px 20px;
    }
}
@media (max-width:480px) {
    .navbar-brand .fa-compass {
        font-size: 1.4rem;
    }
    .navbar-toggler {
        padding: 4px 7px !important;
    }
    .mobile-menu .nav-link {
        font-size: 13px !important;
    }
}
