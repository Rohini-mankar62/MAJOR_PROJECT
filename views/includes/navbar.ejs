<script>

    let adults = 7;
    let children = 0;
    let infants = 0;
    let pets = 0;

    // Get elements
    const adultsCount = document.getElementById("adultsCount");
    const childrenCount = document.getElementById("childrenCount");
    const infantsCount = document.getElementById("infantsCount");
    const petsCount = document.getElementById("petsCount");

    const guestSummary = document.getElementById("guestSummary");


    // Function to update all numbers
    function updateGuests() {

        adultsCount.innerText = adults;
        childrenCount.innerText = children;
        infantsCount.innerText = infants;
        petsCount.innerText = pets;


        // Total guests
        let totalGuests = adults + children;


        if (totalGuests === 1) {

            guestSummary.innerText = "1 guest";

        } else {

            guestSummary.innerText = totalGuests + " guests";

        }
    }


    // All + and - buttons
    document.querySelectorAll(".counter-btn").forEach(button => {

        button.addEventListener("click", function(event) {

            // Don't close dropdown
            event.stopPropagation();


            const type = this.dataset.type;
            const action = this.dataset.action;


            // Adults
            if (type === "adults") {

                if (action === "plus") {

                    adults++;

                } else if (action === "minus" && adults > 0) {

                    adults--;

                }

            }


            // Children
            if (type === "children") {

                if (action === "plus") {

                    children++;

                } else if (action === "minus" && children > 0) {

                    children--;

                }

            }


            // Infants
            if (type === "infants") {

                if (action === "plus") {

                    infants++;

                } else if (action === "minus" && infants > 0) {

                    infants--;

                }

            }


            // Pets
            if (type === "pets") {

                if (action === "plus") {

                    pets++;

                } else if (action === "minus" && pets > 0) {

                    pets--;

                }

            }


            // Update screen
            updateGuests();

        });

    });


    // Initial display
    updateGuests();

</script>